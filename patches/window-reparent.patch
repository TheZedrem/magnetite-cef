+void CefWindowView::UpdateParent() {
+  // Only a Window that was created with a parent can get another one.
+  views::Widget* old_host = host_widget();
+  views::Widget* widget = GetWidget();
+  if (!old_host || !widget || !cef_delegate()) {
+    return;
+  }
+
+  CefRefPtr<CefWindow> cef_window = GetCefWindow();
+  bool is_menu = false;
+  bool can_activate_menu = true;
+  CefRefPtr<CefWindow> parent_window = cef_delegate()->GetParentWindow(
+      cef_window, &is_menu, &can_activate_menu);
+  if (!parent_window || is_menu || parent_window->IsSame(cef_window)) {
+    return;
+  }
+  views::Widget* new_host =
+      static_cast<CefWindowImpl*>(parent_window.get())->widget();
+  if (!new_host || new_host == old_host) {
+    return;
+  }
+
+#if BUILDFLAG(IS_LINUX)
+#if BUILDFLAG(SUPPORTS_OZONE_X11)
+  if (UsesX11()) {
+    // As in CreateWidget and WindowClosing.
+    auto x11window =
+        static_cast<x11::Window>(view_util::GetWindowHandle(widget));
+    auto old_parent = static_cast<gfx::AcceleratedWidget>(
+        view_util::GetWindowHandle(old_host));
+    auto new_parent = static_cast<gfx::AcceleratedWidget>(
+        view_util::GetWindowHandle(new_host));
+    CHECK(x11window != x11::Window::None && old_parent && new_parent);
+
+    auto* delegate = ui::LinuxUiDelegate::GetInstance();
+    delegate->SetTransientWindowForParent(
+        old_parent, static_cast<gfx::AcceleratedWidget>(x11::Window::None));
+    x11::Connection::Get()->SetProperty(
+        x11window, x11::Atom::WM_TRANSIENT_FOR, x11::Atom::WINDOW, new_parent);
+    delegate->SetTransientWindowForParent(
+        new_parent, static_cast<gfx::AcceleratedWidget>(x11window));
+  }
+#endif
+#endif  // BUILDFLAG(IS_LINUX)
+
+  // The platform's own reparenting. Under Wayland it moves our wl_subsurface
+  // into the new parent (WaylandBubble::SetParentWidget).
+  widget->Reparent(new_host);
+
+  host_widget_destruction_observer_ =
+      std::make_unique<WidgetDestructionObserver>(new_host);
+}
